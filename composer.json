{
    "name": "ebln/phpstan-factory-rule",
    "description": "PHPStan rule to enforce instanciation by factories",
    "license": "MIT",
    "type": "phpstan-extension",
    "authors": [
        {
            "name": "ebln",
            "email": "34722048+ebln@users.noreply.github.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "phpstan/phpstan": "^2.2"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.54",
        "phpmd/phpmd": "^3.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "roave/security-advisories": "dev-latest"
    },
    "conflict": {
        "ebln/phpstan-factory-mark": "*"
    },
    "autoload": {
        "psr-4": {
            "Ebln\\Attrib\\": "attrib/",
            "Ebln\\PHPStan\\EnforceFactory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\Ebln\\PHPStan\\EnforceFactory\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "sort-packages": true
    },
    "extra": {
        "phpstan": {
            "includes": [
                "rules.neon"
            ]
        }
    },
    "scripts": {
        "coverage": "XDEBUG_MODE=coverage phpunit --coverage-html coverage --coverage-text --colors=auto && chown -R 1000:1000 coverage",
        "quality": [
            "composer normalize --dry-run",
            "@test-unit",
            "phpstan analyse",
            "@style-check",
            "phpmd analyze src --format ansi --ruleset codesize --ruleset controversial --ruleset naming --ruleset unusedcode",
            "phpmd analyze tests --format ansi --ruleset codesize --ruleset controversial --ruleset design --exclude '*tests/data/*' --exclude '*tests/dataAttrib/*' --exclude '*tests/dataMixed/*'"
        ],
        "style-check": "php-cs-fixer fix -v --config=.php-cs-fixer.dist.php --using-cache=no --dry-run",
        "style-fix": "php-cs-fixer fix -v --config=.php-cs-fixer.dist.php --using-cache=no",
        "test-unit": "phpunit --no-coverage --colors=auto"
    }
}
