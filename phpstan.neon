includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: max
    phpVersion:
        min: 80200
        max: 80599
    paths:
        - attrib
        - src
        - tests
    excludePaths:
        - tests/Fixtures
