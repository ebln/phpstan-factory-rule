#!/bin/sh
# Runs a command in one of the images of compose.yml, as the calling user,
# with the repository mounted at /app. The exit code is the command's.
#
# Usage: .github/ci/run <service> <command> [<argument>...]
set -eu

exec docker compose --file "$(dirname "$0")/compose.yml" run --rm --quiet-pull \
    --user "$(id -u):$(id -g)" "$@"
